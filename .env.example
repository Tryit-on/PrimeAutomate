# Database - Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/prime_automate_systems

# Server
PORT=5005
NODE_ENV=production

# Session - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-strong-random-secret

# Admin panel protection - set a strong random string
ADMIN_API_KEY=change-this-to-a-strong-random-key

# Email Notifications via Resend (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where to send new lead notifications
ADMIN_EMAIL=josephfadero@gmail.com
# Must be a verified sender domain in your Resend account
FROM_EMAIL=leads@primeautomatesystems.com
